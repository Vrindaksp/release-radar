# Neon PostgreSQL — copy the *pooled* connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google AI Studio key for Gemini Flash (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model id. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# GitHub token used to read releases. A fine-grained token with *no* extra
# permissions (public repos, read-only) is enough. Without it GitHub allows
# only 60 requests/hour per IP, which a 20+ repo digest will exhaust quickly.
GITHUB_TOKEN=

# Protects the weekly cron route. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Real-time features ---------------------------------------------------------

# Shared secret for the GitHub release webhook (/api/webhook/github). Use the same
# value as the webhook's "Secret" in GitHub. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Slack incoming-webhook URL for emergency alerts (optional — email or ntfy work without Slack). Leave blank to disable.
# Critical releases always appear in the dashboard banner regardless.
SLACK_WEBHOOK_URL=
# Optional: ping someone on emergency alerts — <!here>, <!channel>, <!subteam^S0123ABC> or <@U0123ABC>
# SLACK_MENTION=<!here>
# Optional: public URL of this deployment, used for the "Open Release Radar" link in alerts.
# APP_URL=https://release-radar.example.com

# Emergency escalation rule (defaults shown): alert when Gemini rates a release a
# critical security fix with high impact, published within the last 72 hours.
# ESCALATION_MIN_SEVERITY=critical   # low | moderate | high | critical
# ESCALATION_MIN_IMPACT=High         # Low | Medium | High
# ESCALATION_MAX_TIER=3              # only repos at tier <= N (1 = critical-path only)
# ESCALATION_MAX_AGE_HOURS=72

# OPTIONAL password for the dashboard (HTTP Basic auth; any username). Leave it unset and the
# app is open — visitors go straight to the digest. When set, everything needs the password
# except /api/webhook/github and GET /api/ingest, which authenticate with
# GITHUB_WEBHOOK_SECRET and CRON_SECRET.
# DASHBOARD_PASSWORD=

# Push notifications for emergency alerts WITHOUT any account: pick a long random topic,
# then install the ntfy app (or open https://ntfy.sh/<topic>) and subscribe to it.
# Whoever knows the topic can read the alerts, so treat it like a password.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Email alerts via Resend (https://resend.com — free tier is plenty). Without a verified
# domain Resend only delivers to the address you signed up with; to email others, verify a
# domain and set ALERT_EMAIL_FROM to an address on it.
# RESEND_API_KEY=
# ALERT_EMAIL_TO=you@example.com            # comma-separated for several recipients
# ALERT_EMAIL_FROM=Release Radar <onboarding@resend.dev>
